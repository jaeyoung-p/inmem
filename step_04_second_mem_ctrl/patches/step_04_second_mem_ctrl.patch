+"""Fixed two-tier ordinary RAM memory component."""
+
+from typing import (
+    Dict,
+    List,
+    Sequence,
+    Tuple,
+)
+
+from m5.objects import (
+    AbstractMemory,
+    MemCtrl,
+)
+from m5.params import (
+    AddrRange,
+    Port,
+)
+from m5.util.convert import toMemorySize
+
+from ...utils.override import overrides
+from ..boards.abstract_board import AbstractBoard
+from .abstract_memory_system import AbstractMemorySystem
+from .dram_interfaces.ddr5 import DDR5_6400_4x8
+
+
+class TwoTierMemory(AbstractMemorySystem):
+    """Two fixed ordinary RAM tiers, each backed by one DDR5 MemCtrl.
+
+    The tiers use the same DRAM interface class. The only intentional
+    performance difference is controller-side static latency.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+
+        object.__setattr__(self, "fast_range", AddrRange(start=0, size="2GiB"))
+        object.__setattr__(
+            self, "slow_range", AddrRange(start=0x100000000, size="1GiB")
+        )
+        self._size = self.fast_range.size() + self.slow_range.size()
+
+        self.fast_dram = DDR5_6400_4x8()
+        self.slow_dram = DDR5_6400_4x8()
+
+        self.fast_ctrl = MemCtrl(dram=self.fast_dram)
+        self.slow_ctrl = MemCtrl(dram=self.slow_dram)
+
+        self.fast_ctrl.static_frontend_latency = "10ns"
+        self.fast_ctrl.static_backend_latency = "10ns"
+        self.slow_ctrl.static_frontend_latency = "40ns"
+        self.slow_ctrl.static_backend_latency = "40ns"
+
+        self.set_memory_range([self.fast_range, self.slow_range])
+
+    def get_default_memory_ranges(self) -> List[AddrRange]:
+        return [self.fast_range, self.slow_range]
+
+    def get_numa_memory_ranges(self) -> Dict[int, List[AddrRange]]:
+        return {
+            0: [self.fast_range],
+            1: [self.slow_range],
+        }
+
+    def get_fast_controller(self) -> MemCtrl:
+        return self.fast_ctrl
+
+    def get_slow_controller(self) -> MemCtrl:
+        return self.slow_ctrl
+
+    def get_fast_port(self) -> Port:
+        return self.fast_ctrl.port
+
+    def get_slow_port(self) -> Port:
+        return self.slow_ctrl.port
+
+    @overrides(AbstractMemorySystem)
+    def incorporate_memory(self, board: AbstractBoard) -> None:
+        pass
+
+    @overrides(AbstractMemorySystem)
+    def get_mem_ports(self) -> Sequence[Tuple[AddrRange, Port]]:
+        return [
+            (self.fast_range, self.fast_ctrl.port),
+            (self.slow_range, self.slow_ctrl.port),
+        ]
+
+    @overrides(AbstractMemorySystem)
+    def get_memory_controllers(self) -> List[MemCtrl]:
+        return [self.fast_ctrl, self.slow_ctrl]
+
+    @overrides(AbstractMemorySystem)
+    def get_mem_interfaces(self) -> List[AbstractMemory]:
+        return [self.fast_dram, self.slow_dram]
+
+    @overrides(AbstractMemorySystem)
+    def get_size(self) -> int:
+        return self._size
+
+    @overrides(AbstractMemorySystem)
+    def get_uninterleaved_range(self) -> List[AddrRange]:
+        return [self.fast_range, self.slow_range]
+
+    @overrides(AbstractMemorySystem)
+    def set_memory_range(self, ranges: List[AddrRange]) -> None:
+        expected_fast_size = toMemorySize("2GiB")
+        expected_slow_size = toMemorySize("1GiB")
+
+        if (
+            len(ranges) != 2
+            or int(ranges[0].start) != 0
+            or ranges[0].size() != expected_fast_size
+            or int(ranges[1].start) != 0x100000000
+            or ranges[1].size() != expected_slow_size
+        ):
+            raise ValueError(
+                "TwoTierMemory requires exactly two fixed RAM ranges: "
+                "[0, 2GiB) and [4GiB, 5GiB)."
+            )
+
+        object.__setattr__(self, "fast_range", ranges[0])
+        object.__setattr__(self, "slow_range", ranges[1])
+        self._size = self.fast_range.size() + self.slow_range.size()
+
+        self.fast_dram.range = self.fast_range
+        self.slow_dram.range = self.slow_range
